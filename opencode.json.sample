{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "chief-go",
  "subagent_depth": 2,
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "read": {
      "**/.env": "deny",
      "*.env": "deny",
      "**/.ssh/**": "deny",
      "**/*.pem": "deny",
      "**/auth.json": "deny",
      "**/.aws/credentials": "deny",
      "**/.netrc": "deny"
    },
    "skill": {
      "*": "allow"
    },
    "external_directory": {
      "/tmp/*": "allow"
    }
  },
  "compaction": {
    "prune": true
  },
  "agent": {
    "build": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  }
}
